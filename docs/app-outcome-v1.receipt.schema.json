{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "app-outcome/1"
    },
    "applied": {
      "type": "boolean"
    },
    "state": {
      "type": "string",
      "enum": [
        "applied",
        "gap_pending",
        "blocked"
      ]
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9:_-]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9:_-]+$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "stream": {
      "type": "string",
      "maxLength": 2048
    },
    "remoteRecordRef": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "currentVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "terminalRevoked": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "applied",
    "state",
    "eventId",
    "digest",
    "sourceRecord",
    "stream",
    "remoteRecordRef",
    "currentVersion",
    "terminalRevoked"
  ],
  "additionalProperties": false
}
