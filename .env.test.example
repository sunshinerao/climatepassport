# Climate Passport 测试环境变量示例
# 复制本文件为 .env.test.local 并根据本地环境修改

# 测试数据库（必须独立于开发数据库，避免污染真实数据）
DATABASE_URL="postgresql://rr@localhost:5432/climatepassport_test"
DIRECT_URL="postgresql://rr@localhost:5432/climatepassport_test"
CLIMATE_PASSPORT_DATABASE_URL="postgresql://rr@localhost:5432/climatepassport_test"

# 可选：SHCW 相关测试数据库
SHCW_DATABASE_URL="postgresql://rr@localhost:5432/shcw2026_test"

# 测试站点地址
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3100"
CP_TEST_BASE_URL="http://127.0.0.1:3100"
CP_TEST_ENV_ID="climate-passport-isolated-test"

# 限流配置（测试环境可关闭或降低敏感度）
RATE_LIMIT_MODE="local"
RATE_LIMIT_TRUST_PROXY="false"
RATE_LIMIT_REST_URL=""
RATE_LIMIT_REST_TOKEN=""
RATE_LIMIT_REST_TIMEOUT_MS="2000"

# 邮件测试必须使用本地桩或测试账户，不得读取开发/生产密钥
RESEND_API_KEY=""
MAIL_FROM=""
MAIL_TRANSPORT="test-outbox"
MAIL_TEST_OUTBOX_PATH="test-results/mail-outbox.jsonl"

# 证书附件存储（测试环境使用本地存储）
CERTIFICATE_ARTIFACT_STORAGE="local"
CERTIFICATE_ARTIFACT_LOCAL_ROOT="/tmp/climatepassport-test-certificates"

# 功能开关（测试环境按需开启）
CHANNEL_SHCW_ENABLED="false"
AI_CONTENT_ASSIST_ENABLED="false"

# Node 环境
NODE_ENV="test"

# CP-TODO-248 controlled asset storage (local test/dev mode)
CONTROLLED_ASSET_STORAGE="local"
CONTROLLED_ASSET_LOCAL_ROOT="/tmp/climate-passport-controlled-assets"

# API 集成测试并行文件共享同一管理员账号登录：上调登录限流（生产保持默认 8/5min）
RATE_LIMIT_AUTH_LOGIN_LIMIT="200"
