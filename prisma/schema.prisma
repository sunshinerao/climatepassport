generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  VISITOR
  ATTENDEE
  ORGANIZATION
  SPONSOR
  SPEAKER
  MEDIA
  ADMIN
  EVENT_MANAGER
  SPECIAL_PASS_MANAGER
  STAFF
  VERIFIER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum RegistrationStatus {
  PENDING_APPROVAL
  REGISTERED
  CANCELLED
  ATTENDED
  WAITLIST
  REJECTED
}

enum EventLayer {
  INSTITUTION
  ECONOMY
  ROOT
  ACCELERATOR
  COMPREHENSIVE
}

enum EventHostType {
  OFFICIAL
  CO_HOSTED
  REGISTERED
  SIDE_EVENT
  COMMUNITY
}

enum InvitationStatus {
  PENDING
  UPLOADED
  DOWNLOADED
  APPROVED
  REJECTED
}

enum SpecialPassStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SpecialPassEntryType {
  DOMESTIC
  INTERNATIONAL
}

enum ContactCategory {
  GENERAL
  ORGANIZATION
  PARTNERSHIP
  SPEAKER
  MEDIA
  SPONSOR
  VOLUNTEER
  OTHER
}

enum ContactMessageStatus {
  PENDING
  REPLIED
  CLOSED
}

enum NotificationChannel {
  EMAIL
  IN_APP
  SMS
}

enum NotificationStatus {
  QUEUED
  DELIVERED
  READ
  ARCHIVED
}

enum NotificationKind {
  REGISTRATION
  ATTENDANCE
  CERTIFICATE
  INVITATION
  SPECIAL_PASS
  SYSTEM
}

/// Internal redemption accounting only. These records never initiate a provider call.
enum RedemptionIntentStatus {
  CREATED
  RESERVED
  CANCELLED
  EXPIRED
  SETTLED
  REFUNDED
}

enum PointJournalType {
  RESERVE
  CANCEL
  EXPIRE
  SETTLE
  REFUND
}

enum PointPostingAccount {
  USER_AVAILABLE
  USER_RESERVED
  REDEMPTION_CLEARING
}

enum PointPostingDirection {
  DEBIT
  CREDIT
}

enum CertificateTemplateType {
  ATTENDANCE
  LEARNING
  ACHIEVEMENT
  CUSTOM
}

enum CertificateVerificationMode {
  PUBLIC_CODE
  INTERNAL_ONLY
  QR_CODE
}

enum CertificateIssueStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  GENERATED
  ISSUED
  REVOKED
}

enum CertificateArtifactState {
  NONE
  PENDING
  READY
  LEGACY_INLINE
  LEGACY_EXTERNAL
  MISSING
  FAILED
}

enum ActivityCertificateIssuanceStatus {
  PENDING
  ISSUED
  FAILED
}

enum CertificateIssuingRuleTrigger {
  ACTIVITY_CHECKIN
}

enum CertificateApplicationStatus {
  DRAFT
  SUBMITTED
  NEEDS_INFORMATION
  APPROVED
  REJECTED
  WITHDRAWN
}

enum CertificateBatchSource {
  MANUAL_LIST
  CSV
  ACTIVITY_ELIGIBLE_LIST
}

enum CertificateBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_FAILURES
  FAILED
}

enum CertificateBatchItemStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum VerificationResult {
  VALID
  INVALID
  REVOKED
}

enum ChannelKey {
  SHCW
}

enum LearningExperienceProgramStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum LearningExperienceApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW
  OFFERED
  WAITLISTED
  ACCEPTED
  REJECTED
  ENROLLED
  COMPLETED
  WITHDRAWN
}

enum LearningExperienceParticipationStatus {
  ADMITTED
  ACTIVE
  COMPLETED
  WITHDRAWN
}

enum QrTokenType {
  IDENTITY
  EVENT_CHECKIN
  ACTIVITY_CHECKIN
  CERTIFICATE_VERIFICATION
  INVITATION_SPECIAL_PASS
}

enum QrTokenStatus {
  ACTIVE
  CONSUMED
  REVOKED
  EXPIRED
}

enum AchievementType {
  LEARNING
  EVENT
  PROJECT
  CONTRIBUTION
  COMMUNICATION
  VERIFIED
}

enum AchievementStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  REVOKED
}

enum AchievementVerificationLevel {
  SELF_RECORDED
  SYSTEM_RECORDED
  PLATFORM_VERIFIED
  INSTITUTION_VERIFIED
  EXPERT_REVIEWED
}

enum AchievementSourceType {
  USER_SUBMISSION
  SYSTEM_EVENT
  COURSE_COMPLETION
  EVENT_REGISTRATION
  EVENT_CHECKIN
  PROJECT_SUBMISSION
  ADMIN_CREATED
  INSTITUTION_IMPORT
  CERTIFICATE_ISSUED
}

enum BadgeCategory {
  PARTICIPATION
  LEARNING
  CAPABILITY
  ROLE
  CONTRIBUTION
  IMPACT
}

enum BadgeLevel {
  EXPLORER
  LEARNER
  PRACTITIONER
  LEADER
  AMBASSADOR
}

enum BadgeVerificationGrade {
  BASIC
  VERIFIED
  INSTITUTIONAL
  EXPERT_REVIEWED
  CREDENTIAL_GRADE
}

enum BadgeAwardStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum AuthEmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum ExternalLearningProviderStatus {
  DRAFT
  ACTIVE
  DISABLED
}

enum ExternalLearningAccountStatus {
  PENDING
  VERIFIED
  DISABLED
}

enum ExternalLearningMappingStatus {
  ACTIVE
  DISABLED
}

enum ExternalLearningSignatureStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ExternalLearningInboxProcessingStatus {
  RECEIVED
  REJECTED
  PENDING_RECONCILIATION
}

enum ExternalLearningEvidenceState {
  RECEIVED
  RECONCILIATION_PENDING
  RECONCILED
  REJECTED
}

enum ExternalLearningReconciliationState {
  NOT_STARTED
  PENDING
  MATCHED
  UNMATCHED
  REJECTED
}

enum ExternalLearningWritebackState {
  NOT_REQUESTED
  BLOCKED
}

enum PortfolioRuleSetStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum PortfolioEvidenceSourceKind {
  ISSUED_CERTIFICATE
  VERIFIED_ACHIEVEMENT
  LEARNING_COMPLETION
  VERIFIED_ACTIVITY_PARTICIPATION
}

enum PortfolioShareConsentMode {
  PRIVATE
  PUBLIC_PROFILE
  DIRECT_SHARE
}

enum PortfolioShareConsentStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum PortfolioShareLinkStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum PersonVerificationStatus {
  DRAFT
  PENDING
  VERIFIED
  REJECTED
}

enum PersonAffiliationStatus {
  ACTIVE
  ENDED
  PENDING
}

enum PersonRoleType {
  SPEAKER
  MODERATOR
  PANELIST
  MENTOR
  ORGANIZER
  PARTNER
  MEDIA
  VOLUNTEER
  STAFF
  OTHER
}

enum InstitutionVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

model User {
  governanceBindings GovernanceBinding[]
  governanceRewardGrants GovernanceRewardGrant[]
  governanceParticipations GovernanceParticipation[]
  appOutcomeBindings AppOutcomeBinding[]
  id                String     @id @default(uuid())
  email             String     @unique
  password          String
  name              String
  salutation        String?
  avatar            String?
  phone             String?
  title             String?
  bio               String?    @db.Text
  country           String?
  role              UserRole   @default(ATTENDEE)
  status            UserStatus @default(ACTIVE)
  staffPermissions  String?    @db.Text
  passCode          String     @unique @default(uuid())
  climatePassportId String?    @unique
  points            Int        @default(0)
  emailVerified     DateTime?
  resetToken        String?    @unique
  resetTokenExpiry  DateTime?
  anonymizedAt      DateTime?
  anonymizedReason  String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  organization                      Organization?
  registrations                     Registration[]
  checkins                          CheckIn[]
  accounts                          Account[]
  sessions                          Session[]
  wishlist                          Wishlist[]
  pointTransactions                 PointTransaction[]
  redemptionIntents                 RedemptionIntent[]
  invitationRequests                InvitationRequest[]
  specialPasses                     SpecialPass[]
  contactMessages                   ContactMessage[]
  notificationPreference            NotificationPreference?
  notifications                     Notification[]
  managedEvents                     Event[]                           @relation("EventManager")
  assignedEvents                    EventVerifier[]
  certificateIssues                 CertificateIssue[]                @relation("CertificateOwner")
  scopedRecordsOwned                ScopedRecord[]                    @relation("ScopedRecordOwner")
  scopedRecordsCreated              ScopedRecord[]                    @relation("ScopedRecordCreator")
  controlledAssets                  ControlledAsset[]                 @relation("ControlledAssetOwner")
  consentSubjects                   ConsentRecord[]                   @relation("ConsentSubject")
  consentGrantors                   ConsentRecord[]                   @relation("ConsentGrantor")
  consentGuardianFor                ConsentRecord[]                   @relation("ConsentGuardian")
  evidenceVersionsCreated           EvidenceVersion[]                 @relation("EvidenceCreator")
  recordRevisionsCreated            RecordRevision[]                  @relation("RecordRevisionCreator")
  notificationAttempts              NotificationAttempt[]             @relation("NotificationActor")
  approvedCertificates              CertificateIssue[]                @relation("CertificateApprover")
  revokedCertificates               CertificateIssue[]                @relation("CertificateRevoker")
  restoredCertificates              CertificateIssue[]                @relation("CertificateRestorer")
  certificateApplications           CertificateApplication[]          @relation("CertificateApplicant")
  reviewedCertificateApplications   CertificateApplication[]          @relation("CertificateApplicationReviewer")
  certificateApplicationEvents      CertificateApplicationEvent[]     @relation("CertificateApplicationEventActor")
  certificateBatchesCreated         CertificateBatch[]                @relation("CertificateBatchCreator")
  certificateChecks                 CertificateVerification[]         @relation("CertificateVerifiedBy")
  qrTokens                          QrToken[]
  auditLogs                         CoreAuditLog[]                    @relation("CoreAuditActor")
  unlockedAchievements              UserAchievement[]
  achievements                      Achievement[]
  badgeAwards                       BadgeAward[]
  milestones                        PassportMilestone[]
  channelSessionBridges             ChannelSessionBridge[]
  managedLearningExperiencePrograms LearningExperienceProgram[]       @relation("LearningExperienceManager")
  learningExperienceApplications    LearningExperienceApplication[]
  learningExperienceParticipations  LearningExperienceParticipation[]
  summerSchoolApplications          SummerSchoolApplication[]
  activityWishlists                 ActivityWishlist[]
  activityVerifiers                 ActivityVerifier[]
  activityApplications              ActivityApplication[]
  activityCommunityMembers          ActivityCommunityMember[]
  activityCommunityPosts            ActivityCommunityPost[]           @relation("ActivityCommunityPostAuthor")
  activityCommunityComments         ActivityCommunityComment[]        @relation("ActivityCommunityCommentAuthor")
  activityCommunityReports          ActivityCommunityReport[]         @relation("ActivityCommunityReportReporter")
  authEmailTokens                   AuthEmailToken[]
  externalLearningAccounts          ExternalLearningAccount[]
  portfolioShareConsent             PortfolioShareConsent?
  portfolioShareLinks               PortfolioShareLink[]
  activityAiContentDrafts           ActivityAiContentDraft[]          @relation("ActivityAiContentDraftActor")
  person                            Person?
  accessMemberships                 AccessMembership[]
  grantedAccessMemberships          AccessMembership[]                @relation("AccessMembershipGrantor")
  subjectObjectAuthorizations       ObjectAuthorization[]             @relation("ObjectAuthorizationSubject")
  grantedObjectAuthorizations       ObjectAuthorization[]             @relation("ObjectAuthorizationGrantor")
  institutionRepresentations        InstitutionRepresentation[]
  grantedInstitutionRepresentations InstitutionRepresentation[]       @relation("InstitutionRepresentationGrantor")
  createdActivityPersonRoles        ActivityPersonRole[]

  @@index([email])
  @@index([passCode])
  @@index([role])
  @@map("users")
}

model CompetencyDimension {
  id            String   @id @default(uuid())
  key           String   @unique
  name          String
  nameEn        String?
  description   String?  @db.Text
  descriptionEn String?  @db.Text
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  evidenceRules PortfolioEvidenceRule[]

  @@map("competency_dimensions")
}

model PortfolioRuleSet {
  id              String                 @id @default(uuid())
  version         Int                    @unique
  status          PortfolioRuleSetStatus @default(DRAFT)
  name            String
  createdByUserId String?
  activatedAt     DateTime?
  retiredAt       DateTime?
  createdAt       DateTime               @default(now())

  evidenceRules PortfolioEvidenceRule[]

  @@index([status])
  @@map("portfolio_rule_sets")
}

model PortfolioEvidenceRule {
  id            String                      @id @default(uuid())
  ruleSetId     String
  dimensionId   String
  sourceKind    PortfolioEvidenceSourceKind
  predicateJson Json
  weight        Int                         @default(1)
  reason        String                      @db.Text
  reasonEn      String?                     @db.Text
  distinctKey   String?
  createdAt     DateTime                    @default(now())

  ruleSet   PortfolioRuleSet    @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  dimension CompetencyDimension @relation(fields: [dimensionId], references: [id], onDelete: Restrict)

  @@index([ruleSetId, sourceKind])
  @@map("portfolio_evidence_rules")
}

model PortfolioShareConsent {
  id             String                      @id @default(uuid())
  userId         String                      @unique
  mode           PortfolioShareConsentMode   @default(PRIVATE)
  status         PortfolioShareConsentStatus @default(ACTIVE)
  fieldAllowlist String[]
  policyVersion  String
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("portfolio_share_consents")
}

model PortfolioShareLink {
  id             String                   @id @default(uuid())
  userId         String
  tokenHash      String                   @unique
  fieldAllowlist String[]
  policyVersion  String
  expiresAt      DateTime
  maxAccessCount Int?
  accessCount    Int                      @default(0)
  status         PortfolioShareLinkStatus @default(ACTIVE)
  revokedAt      DateTime?
  createdAt      DateTime                 @default(now())

  user                       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectApplicationConsents ProjectApplicationConsent[]

  @@index([userId, status])
  @@map("portfolio_share_links")
}

model ExternalLearningProvider {
  id                     String                         @id @default(uuid())
  key                    String                         @unique
  webhookPathKey         String                         @unique
  displayName            String
  status                 ExternalLearningProviderStatus @default(DRAFT)
  verificationConfigJson Json?
  signingSecretRef       String?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  accounts       ExternalLearningAccount[]
  courseMappings ExternalLearningCourseMapping[]
  inboxEvents    ExternalLearningInboxEvent[]
  evidence       ExternalLearningEvidence[]

  @@map("external_learning_providers")
}

model ExternalLearningAccount {
  id                  String                        @id @default(uuid())
  providerId          String
  userId              String
  externalSubjectHash String
  status              ExternalLearningAccountStatus @default(PENDING)
  verifiedAt          DateTime?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  provider ExternalLearningProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, externalSubjectHash])
  @@index([userId, status])
  @@map("external_learning_accounts")
}

model ExternalLearningCourseMapping {
  id                          String                        @id @default(uuid())
  providerId                  String
  externalCourseHash          String
  learningExperienceProgramId String?
  activityId                  String?
  status                      ExternalLearningMappingStatus @default(ACTIVE)
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt

  provider                  ExternalLearningProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  learningExperienceProgram LearningExperienceProgram? @relation(fields: [learningExperienceProgramId], references: [id], onDelete: Restrict)
  activity                  Activity?                  @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@unique([providerId, externalCourseHash])
  @@index([learningExperienceProgramId, status])
  @@index([activityId, status])
  @@map("external_learning_course_mappings")
}

model ExternalLearningInboxEvent {
  id                  String                                @id @default(uuid())
  providerId          String
  deliveryId          String
  eventType           String
  signatureStatus     ExternalLearningSignatureStatus
  processingStatus    ExternalLearningInboxProcessingStatus
  payloadSha256       String
  redactedHeadersJson Json
  receivedAt          DateTime                              @default(now())

  provider ExternalLearningProvider   @relation(fields: [providerId], references: [id], onDelete: Restrict)
  evidence ExternalLearningEvidence[]

  @@unique([providerId, deliveryId])
  @@index([providerId, processingStatus, receivedAt])
  @@map("external_learning_inbox_events")
}

model ExternalLearningEvidence {
  id                  String                              @id @default(uuid())
  providerId          String
  inboxEventId        String
  externalEventId     String
  externalSubjectHash String?
  externalCourseHash  String?
  occurredAt          DateTime?
  normalizedDataJson  Json
  evidenceState       ExternalLearningEvidenceState       @default(RECEIVED)
  reconciliationState ExternalLearningReconciliationState @default(NOT_STARTED)
  writebackState      ExternalLearningWritebackState      @default(NOT_REQUESTED)
  createdAt           DateTime                            @default(now())

  provider   ExternalLearningProvider   @relation(fields: [providerId], references: [id], onDelete: Restrict)
  inboxEvent ExternalLearningInboxEvent @relation(fields: [inboxEventId], references: [id], onDelete: Restrict)

  @@unique([providerId, externalEventId])
  @@index([providerId, reconciliationState, createdAt])
  @@map("external_learning_evidence")
}

model Organization {
  id           String   @id @default(uuid())
  name         String
  logo         String?
  website      String?
  description  String?  @db.Text
  industry     String?
  size         String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  userId       String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("organizations")
}

model SiteSetting {
  id              String   @id @default(uuid())
  key             String   @unique
  siteName        String
  siteNameEn      String?
  shortName       String?
  tagline         String?
  taglineEn       String?
  logoColor       String?  @db.Text
  logoMono        String?  @db.Text
  favicon         String?  @db.Text
  supportEmail    String?
  supportPhone    String?
  supportWebsite  String?
  copyrightText   String?  @db.Text
  copyrightTextEn String?  @db.Text
  icpNumber       String?
  themeColor      String?
  themeColorDark  String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("site_settings")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model AuthEmailToken {
  id         String                @id @default(uuid())
  userId     String
  email      String
  purpose    AuthEmailTokenPurpose
  tokenHash  String                @unique
  codeHash   String?               @map("code_hash")
  credentialVersion String       @default("legacy") @map("credential_version")
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int                   @default(0)
  createdAt  DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([email, purpose, createdAt])
  @@index([expiresAt])
  @@map("auth_email_tokens")
}

model Track {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  nameEn        String?
  description   String   @db.Text
  descriptionEn String?  @db.Text
  category      String
  color         String
  icon          String
  partners      Json?
  partnersEn    Json?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  events     Event[]
  activities Activity[]

  @@map("tracks")
}

model Institution {
  governanceProjects GovernanceProject[]
  id                  String                        @id @default(uuid())
  slug                String                        @unique
  name                String
  nameEn              String?
  shortName           String?
  shortNameEn         String?
  legalName           String?
  aliases             String[]
  parentInstitutionId String?
  logo                String?
  website             String?
  orgType             String?
  governanceType      String?
  countryOrRegion     String?
  countryOrRegionEn   String?
  description         String?                       @db.Text
  descriptionEn       String?                       @db.Text
  verificationStatus  InstitutionVerificationStatus @default(UNVERIFIED)
  publicContactEmail  String?
  publicContactPhone  String?
  headquartersAddress String?
  foundingYear        Int?
  isActive            Boolean                       @default(true)
  mergedIntoId        String?
  order               Int                           @default(0)
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  parentInstitution    Institution?                @relation("InstitutionParent", fields: [parentInstitutionId], references: [id], onDelete: SetNull)
  childInstitutions    Institution[]               @relation("InstitutionParent")
  speakers             Speaker[]
  events               EventInstitution[]
  activityInstitutions ActivityInstitution[]
  personAffiliations   PersonAffiliation[]
  personRoleProfiles   PersonRoleProfile[]
  representations      InstitutionRepresentation[]
  mergedInto           Institution?                @relation("InstitutionMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergeSources         Institution[]               @relation("InstitutionMerge")
  contributionFacts    ContributionFact[]          @relation("ContributionFactInstitution")

  @@index([parentInstitutionId])
  @@index([verificationStatus])
  @@index([mergedIntoId])
  @@map("institutions")
}

model Event {
  id                       String         @id @default(uuid())
  title                    String
  titleEn                  String?
  description              String         @db.Text
  descriptionEn            String?        @db.Text
  shortDesc                String?
  shortDescEn              String?
  highlights               Json?
  highlightsEn             Json?
  highlightsGeneratedAt    DateTime?
  startDate                DateTime
  endDate                  DateTime
  startTime                String
  endTime                  String
  venue                    String
  venueEn                  String?
  address                  String?
  addressEn                String?
  city                     String?
  cityEn                   String?
  image                    String?
  partners                 Json?
  partnersEn               Json?
  type                     String
  eventLayer               EventLayer?
  hostType                 EventHostType?
  trackId                  String?
  managerUserId            String?
  venueCheckinSecret       String?        @unique
  invitationContentHtml_zh String?        @db.Text
  invitationContentHtml_en String?        @db.Text
  maxAttendees             Int?
  requireApproval          Boolean        @default(false)
  isClosed                 Boolean        @default(false)
  isPublished              Boolean        @default(false)
  isFeatured               Boolean        @default(false)
  isPinned                 Boolean        @default(false)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  track                   Track?                               @relation(fields: [trackId], references: [id])
  manager                 User?                                @relation("EventManager", fields: [managerUserId], references: [id])
  registrations           Registration[]
  eventDateSlots          EventDateSlot[]
  agendaItems             AgendaItem[]
  checkins                CheckIn[]
  wishlist                Wishlist[]
  pointTransactions       PointTransaction[]
  invitationRequests      InvitationRequest[]
  verifiers               EventVerifier[]
  qrTokens                QrToken[]
  specialPasses           SpecialPass[]
  institutions            EventInstitution[]
  milestones              PassportMilestone[]
  learningExperienceLinks LearningExperienceProgramEventLink[]

  @@index([startDate])
  @@index([trackId])
  @@index([managerUserId])
  @@index([isPinned, startDate, startTime])
  @@map("events")
}

model EventInstitution {
  id            String   @id @default(uuid())
  eventId       String
  institutionId String
  roleLabel     String?
  roleLabelEn   String?
  showLogo      Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([eventId, institutionId])
  @@index([eventId, order])
  @@index([institutionId])
  @@map("event_institutions")
}

model EventVerifier {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("event_verifiers")
}

model EventDateSlot {
