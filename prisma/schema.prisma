model ActivityCommunityMember {
  id          String                        @id @default(uuid())
  communityId String
  userId      String
  role        ActivityCommunityMemberRole   @default(MEMBER)
  status      ActivityCommunityMemberStatus @default(ACTIVE)
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  community   ActivityCommunity             @relation(fields: [communityId], references: [id], onDelete: Cascade)
