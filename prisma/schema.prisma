model Activity {
  governanceProject GovernanceProject?
  id                               String                @id @default(uuid())
  type                             ActivityType
  title                            String
  titleEn                          String?
  subtitle                         String?
  subtitleEn                       String?
  slug                             String                @unique
  category                         String?
  coverImage                       String?
  posterImage                      String?
  summary                          String?               @db.Text
  summaryEn                        String?               @db.Text
  description                      String?               @db.Text
  descriptionEn                    String?               @db.Text
  highlights                       Json?
  highlightsEn                     Json?
  organizerUserId                  String?
  organizerName                    String?
  partnerIds                       String[]
  trackId                          String?
  eventLayer                       EventLayer?
  hostType                         EventHostType?
  startTime                        DateTime?
  endTime                          DateTime?
  timezone                         String                @default("UTC")
  locationType                     ActivityLocationType?
  locationJson                     Json?
  onlineUrl                        String?
  mapUrl                           String?
  status                           ActivityStatus        @default(DRAFT)
  visibility                       ActivityVisibility    @default(PUBLIC)
  capacity                         Int?
  registrationOpenAt               DateTime?
  registrationCloseAt              DateTime?
  requiresApproval                 Boolean               @default(false)
  applicantListVisibleToApplicants Boolean               @default(false)
  allowInterestWithoutApplication  Boolean               @default(false)
  isPrivate                        Boolean               @default(false)
  isFeatured                       Boolean               @default(false)
  isPinned                         Boolean               @default(false)
  language                         String                @default("zh")
  tags                             String[]
  createdByUserId                  String
  createdAt                        DateTime              @default(now())
  updatedAt                        DateTime              @updatedAt

  track                         Track?                          @relation(fields: [trackId], references: [id], onDelete: SetNull)
  detail                        ActivityDetail?
  roles                         ActivityRole[]
  tasks                         ActivityTask[]
  rewardRules                   ActivityRewardRule[]
  certificateRules              ActivityCertificateRule[]
  certificateIssuances          ActivityCertificateIssuance[]
  applications                  ActivityApplication[]
  participations                ActivityParticipation[]
  reviewWorkflows               ActivityReviewWorkflow[]
  checkinRecords                ActivityCheckinRecord[]
  submissions                   ActivitySubmission[]
  qrTokens                      QrToken[]
  agendaItems                   ActivityAgendaItem[]
  speakerLinks                  ActivitySpeaker[]
  wishlists                     ActivityWishlist[]
  dateSlots                     ActivityDateSlot[]
  occurrences                   ActivityOccurrence[]
  personRoles                   ActivityPersonRole[]
  externalClassifications       ActivityExternalClassification[]
  institutions                  ActivityInstitution[]
  verifiers                     ActivityVerifier[]
  community                     ActivityCommunity?
  ExternalLearningCourseMapping ExternalLearningCourseMapping[]
  aiContentDrafts               ActivityAiContentDraft[]
  certificateBatches            CertificateBatch[]
  sourceMappings                SourceObjectMapping[]

  @@index([type, status])
  @@index([status, startTime])
  @@index([organizerUserId])
  @@index([isFeatured, startTime])
  @@index([trackId])
  @@index([isPinned, startTime])
  @@map("activities")
}

/// Human-reviewed AI copy only. It never changes an Activity until an ADMIN publishes it.
model ActivityAiContentDraft {
  id                   String                       @id @default(uuid())
  activityId           String
  kind                 ActivityAiContentDraftKind
  status               ActivityAiContentDraftStatus @default(REQUESTED)
  locale               String
  providerAlias        String?
  modelAlias           String?
  sourceHash           String
  sourceFieldCount     Int
  sourceCharacterCount Int
  outputJson           Json?
  failureCode          String?
  actorUserId          String
  requestedAt          DateTime                     @default(now())
  generatedAt          DateTime?
  editedAt             DateTime?
  approvedAt           DateTime?
  publishedAt          DateTime?
  rejectedAt           DateTime?
  deletedAt            DateTime?
  expiresAt            DateTime
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  actor    User     @relation("ActivityAiContentDraftActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([activityId, status, createdAt])
  @@index([actorUserId, requestedAt])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("activity_ai_content_drafts")
}

model ActivityCommunity {
  id           String                    @id @default(uuid())
  activityId   String                    @unique
  mode         ActivityCommunityMode     @default(OPEN)
