  reviewNotes    String?                            @db.Text
  submittedAt    DateTime?
  reviewedAt     DateTime?
  decidedAt      DateTime?
  createdAt      DateTime                           @default(now())
  updatedAt      DateTime                           @updatedAt

  program        LearningExperienceProgram          @relation(fields: [programId], references: [id], onDelete: Cascade)
  user           User                               @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStage   LearningExperienceStage?           @relation("LearningExperienceCurrentStage", fields: [currentStageId], references: [id], onDelete: SetNull)
  participation  LearningExperienceParticipation?
  summerSchoolApplications SummerSchoolApplication[]

  @@unique([programId, userId])
  @@index([userId, status])
  @@index([programId, status])
  @@map("learning_experience_applications")
}

model LearningExperienceParticipation {
  id                String                                @id @default(uuid())
  programId         String
  userId            String
  applicationId     String?                               @unique
  certificateIssueId String?
  status            LearningExperienceParticipationStatus  @default(ADMITTED)
  completionPercent Int                                   @default(0)
  mentorReviewJson  Json?
  outcomeSummary    String?                               @db.Text
  outcomeSummaryEn  String?                               @db.Text
  pointsAwarded     Int?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime                              @default(now())
  updatedAt         DateTime                              @updatedAt

  program           LearningExperienceProgram             @relation(fields: [programId], references: [id], onDelete: Cascade)
  user              User                                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  application       LearningExperienceApplication?        @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  certificateIssue  CertificateIssue?                     @relation(fields: [certificateIssueId], references: [id], onDelete: SetNull)

  @@unique([programId, userId])
  @@index([userId, status])
  @@index([programId, status])
  @@map("learning_experience_participations")
}

model LearningExperienceProgramEventLink {
  id          String   @id @default(uuid())
