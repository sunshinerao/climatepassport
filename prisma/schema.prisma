  @@index([status, createdAt])
  @@map("certificate_applications")
}

model CertificateApplicationEvent {
  id            String                        @id @default(uuid())
  applicationId String
  actorUserId   String?
  fromStatus    CertificateApplicationStatus?
  toStatus      CertificateApplicationStatus
  kind          String
  createdAt     DateTime                      @default(now())

  application CertificateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User?                  @relation("CertificateApplicationEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@map("certificate_application_events")
}

model CertificateVerification {
  id                  String             @id @default(uuid())
  certificateIssueId  String
  verifiedAt          DateTime           @default(now())
  verifiedBy          String?
  verificationChannel String
  result              VerificationResult @default(VALID)
  metadataJson        Json?

  certificateIssue CertificateIssue @relation(fields: [certificateIssueId], references: [id], onDelete: Cascade)
  verifier         User?            @relation("CertificateVerifiedBy", fields: [verifiedBy], references: [id], onDelete: SetNull)

  @@index([certificateIssueId])
  @@index([verifiedAt])
  @@map("certificate_verifications")
}

model CertificateBatch {
  id                 String                 @id @default(uuid())
  idempotencyKey     String                 @unique
  source             CertificateBatchSource
  status             CertificateBatchStatus @default(PENDING)
  templateId         String
  definitionId       String
  activityId         String?
  issueDate          DateTime?
  variableValuesJson Json?
  notifyRecipients   Boolean                @default(true)
  totalCount         Int                    @default(0)
  succeededCount     Int                    @default(0)
  failedCount        Int                    @default(0)
  error              String?                @db.Text
  completedAt        DateTime?
  createdByUserId    String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  activity   Activity?              @relation(fields: [activityId], references: [id], onDelete: SetNull)
  createdBy  User                   @relation("CertificateBatchCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  definition CertificateDefinition  @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  template   CertificateTemplate    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  items      CertificateBatchItem[]

  @@index([status, createdAt])
  @@index([createdByUserId, createdAt])
  @@map("certificate_batches")
}

model CertificateBatchItem {
  id                 String                     @id @default(uuid())
  batchId            String
  rowIndex           Int
  email              String
  normalizedEmail    String
  status             CertificateBatchItemStatus @default(PENDING)
  attempts           Int                        @default(0)
  leaseExpiresAt     DateTime?
  certificateIssueId String?                    @unique
  error              String?                    @db.Text
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  batch            CertificateBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  certificateIssue CertificateIssue? @relation(fields: [certificateIssueId], references: [id], onDelete: SetNull)

  @@index([batchId, status])
  @@index([normalizedEmail])
  @@map("certificate_batch_items")
}

model ChannelSessionBridge {
  id         String     @id @default(cuid())
  channel    ChannelKey @default(SHCW)
  tokenHash  String     @unique
  userId     String
  targetPath String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channel, expiresAt])
  @@index([userId, createdAt])
  @@map("channel_session_bridges")
}

model QrToken {
  id                 String        @id @default(cuid())
  tokenHash          String        @unique
  type               QrTokenType
  status             QrTokenStatus @default(ACTIVE)
  userId             String?
  eventId            String?
  certificateIssueId String?
  subjectType        String
  subjectId          String
  scopeJson          Json?
  metadataJson       Json?
  expiresAt          DateTime?
  consumedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  activityId String?

  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  event            Event?            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  certificateIssue CertificateIssue? @relation(fields: [certificateIssueId], references: [id], onDelete: Cascade)
  activity         Activity?         @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([type, status])
  @@index([userId, type])
  @@index([eventId, type])
  @@index([certificateIssueId])
  @@index([activityId, type])
  @@index([expiresAt])
