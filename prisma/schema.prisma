generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  VISITOR
  ATTENDEE
  ORGANIZATION
  SPONSOR
  SPEAKER
  MEDIA
  ADMIN
  EVENT_MANAGER
  SPECIAL_PASS_MANAGER
  STAFF
  VERIFIER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum RegistrationStatus {
  PENDING_APPROVAL
  REGISTERED
  CANCELLED
  ATTENDED
  WAITLIST
  REJECTED
}

enum EventLayer {
  INSTITUTION
  ECONOMY
  ROOT
  ACCELERATOR
  COMPREHENSIVE
}

enum EventHostType {
  OFFICIAL
  CO_HOSTED
  REGISTERED
  SIDE_EVENT
  COMMUNITY
}

enum InvitationStatus {
  PENDING
  UPLOADED
  DOWNLOADED
  REJECTED
}

enum SpecialPassStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SpecialPassEntryType {
  DOMESTIC
  INTERNATIONAL
}

enum ContactCategory {
  GENERAL
  ORGANIZATION
  PARTNERSHIP
  SPEAKER
  MEDIA
  SPONSOR
  VOLUNTEER
  OTHER
}

enum ContactMessageStatus {
  PENDING
  REPLIED
  CLOSED
}

enum NotificationChannel {
  EMAIL
  IN_APP
  SMS
}

enum NotificationStatus {
  QUEUED
  DELIVERED
  READ
  ARCHIVED
}

enum NotificationKind {
  REGISTRATION
  ATTENDANCE
  CERTIFICATE
  INVITATION
  SPECIAL_PASS
  SYSTEM
}

enum CertificateTemplateType {
  ATTENDANCE
  LEARNING
  ACHIEVEMENT
  CUSTOM
}

enum CertificateVerificationMode {
  PUBLIC_CODE
  INTERNAL_ONLY
  QR_CODE
}

enum CertificateIssueStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  GENERATED
  ISSUED
  REVOKED
}

enum VerificationResult {
  VALID
  INVALID
  REVOKED
}

enum ChannelKey {
  SHCW
}

enum LearningExperienceProgramStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum LearningExperienceApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW
  OFFERED
  WAITLISTED
  ACCEPTED
  REJECTED
  ENROLLED
  COMPLETED
  WITHDRAWN
}

enum LearningExperienceParticipationStatus {
  ADMITTED
  ACTIVE
  COMPLETED
  WITHDRAWN
}

enum QrTokenType {
  IDENTITY
  EVENT_CHECKIN
  ACTIVITY_CHECKIN
  CERTIFICATE_VERIFICATION
  INVITATION_SPECIAL_PASS
}

enum QrTokenStatus {
  ACTIVE
  CONSUMED
  REVOKED
  EXPIRED
}

enum AchievementType {
  LEARNING
  EVENT
  PROJECT
  CONTRIBUTION
  COMMUNICATION
  VERIFIED
}

enum AchievementStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  REVOKED
}

enum AchievementVerificationLevel {
  SELF_RECORDED
  SYSTEM_RECORDED
  PLATFORM_VERIFIED
  INSTITUTION_VERIFIED
  EXPERT_REVIEWED
}

enum AchievementSourceType {
  USER_SUBMISSION
  SYSTEM_EVENT
  COURSE_COMPLETION
  EVENT_REGISTRATION
  EVENT_CHECKIN
  PROJECT_SUBMISSION
  ADMIN_CREATED
  INSTITUTION_IMPORT
  CERTIFICATE_ISSUED
}

enum BadgeCategory {
  PARTICIPATION
  LEARNING
  CAPABILITY
  ROLE
  CONTRIBUTION
  IMPACT
}

enum BadgeLevel {
  EXPLORER
  LEARNER
  PRACTITIONER
  LEADER
  AMBASSADOR
}

enum BadgeVerificationGrade {
  BASIC
  VERIFIED
  INSTITUTIONAL
  EXPERT_REVIEWED
  CREDENTIAL_GRADE
}

enum BadgeAwardStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum AuthEmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model User {
  id                   String               @id @default(uuid())
  email                String               @unique
  password             String
  name                 String
  salutation           String?
  avatar               String?
  phone                String?
  title                String?
  bio                  String?              @db.Text
  country              String?
  role                 UserRole             @default(ATTENDEE)
  status               UserStatus           @default(ACTIVE)
  staffPermissions     String?              @db.Text
  passCode             String               @unique @default(uuid())
  climatePassportId    String?              @unique
  points               Int                  @default(0)
  emailVerified        DateTime?
  resetToken           String?              @unique
  resetTokenExpiry     DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  organization         Organization?
  registrations        Registration[]
  checkins             CheckIn[]
  accounts             Account[]
  sessions             Session[]
  wishlist             Wishlist[]
  pointTransactions    PointTransaction[]
  invitationRequests   InvitationRequest[]
  specialPasses        SpecialPass[]
  contactMessages      ContactMessage[]
  notificationPreference NotificationPreference?
  notifications        Notification[]
  managedEvents        Event[]              @relation("EventManager")
  assignedEvents       EventVerifier[]
  certificateIssues    CertificateIssue[]   @relation("CertificateOwner")
  approvedCertificates CertificateIssue[]   @relation("CertificateApprover")
  certificateChecks    CertificateVerification[] @relation("CertificateVerifiedBy")
  qrTokens             QrToken[]
  auditLogs            CoreAuditLog[]       @relation("CoreAuditActor")
  unlockedAchievements UserAchievement[]
  achievements         Achievement[]
  badgeAwards          BadgeAward[]
  milestones           PassportMilestone[]
  channelSessionBridges ChannelSessionBridge[]
  managedLearningExperiencePrograms LearningExperienceProgram[] @relation("LearningExperienceManager")
  learningExperienceApplications LearningExperienceApplication[]
  learningExperienceParticipations LearningExperienceParticipation[]
  summerSchoolApplications SummerSchoolApplication[]
  activityWishlists    ActivityWishlist[]
  activityVerifiers    ActivityVerifier[]
  activityApplications ActivityApplication[]
  authEmailTokens      AuthEmailToken[]

  @@index([email])
  @@index([passCode])
  @@index([role])
  @@map("users")
}

model Organization {
  id           String   @id @default(uuid())
  name         String
  logo         String?
  website      String?
  description  String?  @db.Text
  industry     String?
  size         String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  userId       String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("organizations")
}

model SiteSetting {
  id               String   @id @default(uuid())
  key              String   @unique
  siteName         String
  siteNameEn       String?
  shortName        String?
  tagline          String?
  taglineEn        String?
  logoColor        String?  @db.Text
  logoMono         String?  @db.Text
  favicon          String?  @db.Text
  supportEmail     String?
  supportPhone     String?
  supportWebsite   String?
  copyrightText    String?  @db.Text
  copyrightTextEn  String?  @db.Text
  icpNumber        String?
  themeColor       String?
  themeColorDark   String?
  updatedByUserId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("site_settings")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model AuthEmailToken {
  id         String                @id @default(uuid())
  userId     String
  email      String
  purpose    AuthEmailTokenPurpose
  tokenHash  String                @unique
  code       String?
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int                   @default(0)
  createdAt  DateTime              @default(now())

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([email, purpose, createdAt])
  @@index([expiresAt])
  @@map("auth_email_tokens")
}

model Track {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  nameEn        String?
  description   String   @db.Text
  descriptionEn String?  @db.Text
  category      String
  color         String
  icon          String
  partners      Json?
  partnersEn    Json?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  events        Event[]
  activities    Activity[]

  @@map("tracks")
}

model Institution {
  id                String    @id @default(uuid())
  slug              String    @unique
  name              String
  nameEn            String?
  shortName         String?
  shortNameEn       String?
  logo              String?
  website           String?
  orgType           String?
  countryOrRegion   String?
  countryOrRegionEn String?
  description       String?   @db.Text
  descriptionEn     String?   @db.Text
  isActive          Boolean   @default(true)
  order             Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  speakers             Speaker[]
  events               EventInstitution[]
  activityInstitutions ActivityInstitution[]

  @@map("institutions")
}

model Event {
  id                       String            @id @default(uuid())
  title                    String
  titleEn                  String?
  description              String            @db.Text
  descriptionEn            String?           @db.Text
  shortDesc                String?
  shortDescEn              String?
  highlights               Json?
  highlightsEn             Json?
  highlightsGeneratedAt    DateTime?
  startDate                DateTime
  endDate                  DateTime
  startTime                String
  endTime                  String
  venue                    String
  venueEn                  String?
  address                  String?
  addressEn                String?
  city                     String?
  cityEn                   String?
  image                    String?
  partners                 Json?
  partnersEn               Json?
  type                     String
  eventLayer               EventLayer?
  hostType                 EventHostType?
  trackId                  String?
  managerUserId            String?
  venueCheckinSecret       String?           @unique
  invitationContentHtml_zh String?           @db.Text
  invitationContentHtml_en String?           @db.Text
  maxAttendees             Int?
  requireApproval          Boolean           @default(false)
  isClosed                 Boolean           @default(false)
  isPublished              Boolean           @default(false)
  isFeatured               Boolean           @default(false)
  isPinned                 Boolean           @default(false)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  track                    Track?            @relation(fields: [trackId], references: [id])
  manager                  User?             @relation("EventManager", fields: [managerUserId], references: [id])
  registrations            Registration[]
  eventDateSlots           EventDateSlot[]
  agendaItems              AgendaItem[]
  checkins                 CheckIn[]
  wishlist                 Wishlist[]
  pointTransactions        PointTransaction[]
  invitationRequests       InvitationRequest[]
  verifiers                EventVerifier[]
  qrTokens                 QrToken[]
  institutions             EventInstitution[]
  milestones               PassportMilestone[]
  learningExperienceLinks  LearningExperienceProgramEventLink[]

  @@index([startDate])
  @@index([trackId])
  @@index([managerUserId])
  @@index([isPinned, startDate, startTime])
  @@map("events")
}

model EventInstitution {
  id            String      @id @default(uuid())
  eventId       String
  institutionId String
  roleLabel     String?
  roleLabelEn   String?
  showLogo      Boolean     @default(true)
  order         Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([eventId, institutionId])
  @@index([eventId, order])
  @@index([institutionId])
  @@map("event_institutions")
}

model EventVerifier {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("event_verifiers")
}

model EventDateSlot {
  id           String   @id @default(uuid())
  eventId      String
  scheduleDate DateTime
  startTime    String
  endTime      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, scheduleDate])
  @@index([eventId, scheduleDate])
  @@map("event_date_slots")
}

model Registration {
  id            String             @id @default(uuid())
  userId        String
  eventId       String
  status        RegistrationStatus @default(REGISTERED)
  notes         String?
  dietaryReq    String?
  checkedInAt   DateTime?
  checkedInBy   String?
  checkInMethod String?
  pointsEarned  Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  event         Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pointTransactions PointTransaction[]

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@index([checkedInBy])
  @@map("registrations")
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("wishlists")
}

model PointTransaction {
  id             String       @id @default(uuid())
  userId         String
  points         Int
  type           String
  eventId        String?
  registrationId String?
  activityId     String?
  description    String
  createdBy      String?
  createdAt      DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  event          Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([activityId])
  @@index([createdAt])
  @@map("point_transactions")
}

model Speaker {
  id                  String      @id @default(uuid())
  slug                String?     @unique
  salutation          String?
  name                String
  nameEn              String?
  avatar              String?
  title               String
  titleEn             String?
  organization        String
  organizationEn      String?
  organizationLogo    String?
  bio                 String?     @db.Text
  bioEn               String?     @db.Text
  summary             String?     @db.Text
  summaryEn           String?     @db.Text
  countryOrRegion     String?
  countryOrRegionEn   String?
  relevanceToShcw     String?     @db.Text
  relevanceToShcwEn   String?     @db.Text
  expertiseTags       Json?
  email               String?
  linkedin            String?
  twitter             String?
  website             String?
  isKeynote           Boolean     @default(false)
  isVisible           Boolean     @default(true)
  agendaRoleDisplayMode String    @default("allCurrent")
  institutionId       String?
  order               Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  institution         Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  agendaItems         AgendaItem[]
  moderatedItems      AgendaItem[] @relation("AgendaModerator")
  roles               SpeakerRole[]
  activityAgendaItems ActivityAgendaItemSpeaker[]
  moderatedActivityItems ActivityAgendaItem[] @relation("ActivityAgendaModerator")
  activityLinks       ActivitySpeaker[]

  @@map("speakers")
}

model SpeakerRole {
  id             String   @id @default(uuid())
  speakerId      String
  title          String
  titleEn        String?
  organization   String
  organizationEn String?
  startYear      Int?
  endYear        Int?
  isCurrent      Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  speaker        Speaker  @relation(fields: [speakerId], references: [id], onDelete: Cascade)

  @@map("speaker_roles")
}

model AgendaItem {
  id            String    @id @default(uuid())
  eventId       String
  agendaDate    DateTime
  startTime     String
  endTime       String
  title         String
  titleEn       String?
  description   String?   @db.Text
  descriptionEn String?   @db.Text
  type          String
  venue         String?
  speakerMeta   Json?
  moderatorId   String?
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  moderator     Speaker?  @relation("AgendaModerator", fields: [moderatorId], references: [id], onDelete: SetNull)
  speakers      Speaker[]

  @@index([eventId])
  @@index([eventId, agendaDate])
  @@index([moderatorId])
  @@map("agenda_items")
}

model CheckIn {
  id        String   @id @default(uuid())
  userId    String
  eventId   String?
  scannedBy String
  scannedAt DateTime @default(now())
  method    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventId])
  @@index([scannedBy])
  @@map("checkins")
}

model InvitationRequest {
  id               String           @id @default(uuid())
  userId           String
  salutation       String?
  guestName        String
  guestTitle       String?
  guestOrg         String?
  guestEmail       String?
  language         String           @default("zh")
  eventId          String?
  purpose          String?          @db.Text
  notes            String?          @db.Text
  customMainContent String?         @db.Text
  aiEnhancedBodyZh String?          @db.Text
  aiEnhancedBodyEn String?          @db.Text
  signaturePresetId String?
  useStamp         Boolean          @default(false)
  status           InvitationStatus @default(PENDING)
  letterFileUrl    String?
  rejectReason     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  event            Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([eventId])
  @@map("invitation_requests")
}

model SpecialPass {
  id            String               @id @default(uuid())
  userId        String
  entryType     SpecialPassEntryType
  status        SpecialPassStatus    @default(PENDING)
  country       String
  name          String
  birthDate     String
  gender        String
  docNumber     String
  docValidFrom  String
  docValidTo    String
  docPhoto      String?              @db.Text
  docPhotoBack  String?              @db.Text
  photo         String?              @db.Text
  organization  String?
  jobTitle      String?
  docType       String?
  email         String?
  phoneArea     String?
  phone         String?
  contactMethod String?
  contactValue  String?
  adminNotes    String?              @db.Text
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([entryType])
  @@map("special_passes")
}

model ContactMessage {
  id            String               @id @default(uuid())
  name          String
  email         String
  phone         String?
  organization  String?
  userId        String?
  category      ContactCategory      @default(GENERAL)
  subject       String
  message       String               @db.Text
  metadata      Json?
  status        ContactMessageStatus @default(PENDING)
  adminReply    String?              @db.Text
  adminNotes    String?              @db.Text
  repliedAt     DateTime?
  repliedBy     String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@map("contact_messages")
}

model NotificationPreference {
  id               String    @id @default(uuid())
  userId           String    @unique
  emailEnabled     Boolean   @default(true)
  inAppEnabled     Boolean   @default(true)
  smsEnabled       Boolean   @default(false)
  marketingEnabled Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model Notification {
  id          String             @id @default(uuid())
  userId      String
  channel     NotificationChannel @default(IN_APP)
  status      NotificationStatus  @default(QUEUED)
  kind        NotificationKind    @default(SYSTEM)
  title       String
  titleEn     String?
  body        String              @db.Text
  bodyEn      String?             @db.Text
  actionUrl   String?
  metadata    Json?
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([kind])
  @@map("notifications")
}

model AchievementDefinition {
  id            String               @id @default(uuid())
  key           String               @unique
  name          String
  nameEn        String?
  description   String?              @db.Text
  descriptionEn String?              @db.Text
  pointThreshold Int?
  isActive      Boolean              @default(true)
  order         Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  userAchievements UserAchievement[]
  certificateDefinitions CertificateDefinition[]

  @@map("achievement_definitions")
}

model Achievement {
  id                    String                       @id @default(uuid())
  userId                String
  name                  String
  description           String?                      @db.Text
  type                  AchievementType
  status                AchievementStatus            @default(APPROVED)
  verificationLevel     AchievementVerificationLevel @default(SYSTEM_RECORDED)
  sourceType            AchievementSourceType?
  sourceId              String?
  relatedCourseId       String?
  relatedEventId        String?
  relatedProjectId      String?
  relatedCertificateId  String?
  issuerName            String?
  issuerOrganization    String?
  validatorUserId       String?
  validatedAt           DateTime?
  evidenceUrl           String?
  evidenceText          String?
  evidenceJson          Json?
  points                Int                          @default(0)
  skillTags             String[]
  topicTags             String[]
  sdgTags               String[]
  isPublic              Boolean                      @default(true)
  isBadgeEligible       Boolean                      @default(true)
  completedAt           DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  user                  User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, status])
  @@index([verificationLevel])
  @@index([sourceType, sourceId])
  @@map("achievements")
}

model BadgeDefinition {
  id                       String                       @id @default(uuid())
  code                     String                       @unique
  name                     String
  nameZh                   String?
  description              String?                      @db.Text
  descriptionZh            String?                      @db.Text
  category                 BadgeCategory
  level                    BadgeLevel?
  verificationGrade        BadgeVerificationGrade       @default(BASIC)
  issuerName               String?
  issuerOrganization       String?
  issuerLogoUrl            String?
  iconUrl                  String?
  sealImageUrl             String?
  colorTheme               String?
  criteriaText             String?
  criteriaJson             Json?
  requiredPoints           Int?
  requiredAchievementTypes AchievementType[]
  requiredAchievementIds   String[]
  requiredSkillTags        String[]
  requiredTopicTags        String[]
  minVerificationLevel     AchievementVerificationLevel?
  validityDays             Int?
  isRenewable              Boolean                      @default(false)
