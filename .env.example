DATABASE_URL="postgresql://postgres:postgres@localhost:5432/climatepassport"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/climatepassport"
SHCW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shcw2026"
CLIMATE_PASSPORT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/climatepassport"
NEXT_PUBLIC_SITE_URL="https://www.climatepass.org"
RATE_LIMIT_MODE="auto"
RATE_LIMIT_TRUST_PROXY="false"
RATE_LIMIT_REST_URL="https://your-redis-rest-endpoint"
RATE_LIMIT_REST_TOKEN="your-redis-rest-token"
RATE_LIMIT_REST_TIMEOUT_MS="2000"
# Versioned v1 SHCW channel API is fail-closed unless explicitly enabled.
CHANNEL_SHCW_ENABLED="false"
# Comma-separated absolute internal locale roots only; no external URLs.
CHANNEL_SHCW_TARGET_PATH_PREFIXES="/en,/zh,/fr,/de"
# Required for newly generated private certificate artifacts. Local paths must be durable volumes in production.
CERTIFICATE_ARTIFACT_STORAGE="local"
CERTIFICATE_ARTIFACT_LOCAL_ROOT="/absolute/path/to/private/certificate-artifacts"
# Development/test may use Playwright. Production must explicitly provide a browser runtime or trusted HTTPS renderer.
CERTIFICATE_PDF_RENDERER="playwright"
CERTIFICATE_PDF_RENDER_TIMEOUT_MS="20000"
# CERTIFICATE_PDF_RENDERER_URL="https://private-pdf-renderer.example.internal/render"
# CERTIFICATE_PDF_RENDERER_AUTHORIZATION="Bearer replace-me"
# Disabled by default. Activity copy assistance is ADMIN-reviewed and uses one configured provider only.
AI_CONTENT_ASSIST_ENABLED="false"
AI_CONTENT_ASSIST_PROVIDER="openai"
AI_CONTENT_ASSIST_MODEL="gpt-4o-mini"
# AI_CONTENT_ASSIST_OPENAI_API_KEY="replace-me"
# Generic private adapter alternative (do not put this authorization value in client-side variables).
# CERTIFICATE_ARTIFACT_HTTP_BASE_URL="https://private-artifacts.example.internal"
# CERTIFICATE_ARTIFACT_HTTP_AUTHORIZATION="Bearer replace-me"

# CP-TODO-248 controlled asset storage (local test/dev mode)
CONTROLLED_ASSET_STORAGE="local"
CONTROLLED_ASSET_LOCAL_ROOT="/tmp/climate-passport-controlled-assets"
